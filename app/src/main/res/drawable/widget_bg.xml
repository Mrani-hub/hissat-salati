<?xml version="1.0" encoding="utf-8"?>
<!-- Fond du widget : le même dégradé bleu nuit que la carte « اليوم » de l'application,
     avec des coins arrondis pour se poser proprement sur n'importe quel fond d'écran. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="315"
        android:startColor="#10233A"
        android:endColor="#2B4463"
        android:type="linear" />
</shape>
