<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de l'écran d'accueil.

  Tout est en identifiants fixes (wName, wT0...) : un widget ne peut pas être
  construit au vol comme une page web, le code Java ne fait que remplir des
  cases déjà posées ici. La direction est forcée en RTL, parce que le contenu
  est arabe même si le téléphone est réglé en français.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:layoutDirection="rtl">

    <!-- ligne du haut : la ville, et la date du jour en hégirien -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/wCity"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#E3B457"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/wDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#A9C6DA"
            android:maxLines="1" />
    </LinearLayout>

    <!-- la prière annoncée : à droite son nom et son heure, à gauche le temps restant -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wLead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#99FFFFFF"
                android:maxLines="1"
                android:text="@string/widget_lead_next" />

            <TextView
                android:id="@+id/wLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/wName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1" />

            <TextView
                android:id="@+id/wAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textColor="#E8F2F8"
                android:gravity="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- part du créneau déjà écoulée -->
    <ProgressBar
        android:id="@+id/wBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        android:progressTint="#FFFFFF"
        android:progressBackgroundTint="#3DFFFFFF" />

    <!-- les cinq prières du jour -->
    <LinearLayout
        android:id="@+id/wRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/wN0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/wT0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/wN1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/wT1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/wN2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/wT2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/wN3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/wT3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:id="@+id/wN4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/wT4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
